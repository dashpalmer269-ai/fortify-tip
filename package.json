{
  "name": "fortify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:types": "supabase gen types typescript --project-id cqxvzsbyoeporgyjmrcp > lib/supabase/database.types.ts && echo 'Wrote lib/supabase/database.types.ts. Review the diff and commit.'",
    "test:no-phi": "tsx scripts/test-no-phi.ts",
    "test:no-phi-e2e": "tsx scripts/test-no-phi-e2e.ts",
    "test:admin-flow": "tsx scripts/test-admin-flow.ts",
    "test:approval-flow": "tsx scripts/test-approval-flow.ts",
    "test:approval-perms": "tsx scripts/test-approval-perms.ts",
    "test:edit-staff": "tsx scripts/test-edit-staff.ts",
    "test:all": "tsx scripts/test-no-phi.ts && tsx scripts/test-no-phi-e2e.ts && tsx scripts/test-approval-flow.ts && tsx scripts/test-approval-perms.ts && tsx scripts/test-edit-staff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@aws-sdk/client-cloudtrail": "^3.1057.0",
    "@aws-sdk/client-ec2": "^3.1057.0",
    "@aws-sdk/client-guardduty": "^3.1057.0",
    "@aws-sdk/client-iam": "^3.1057.0",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/client-sts": "^3.1057.0",
    "@sentry/nextjs": "^10.56.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "@vercel/analytics": "^2.0.1",
    "marked": "^18.0.3",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.5",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "supabase": "^2.101.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
